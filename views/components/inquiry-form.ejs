<!-- Inquiry form card -->
<div class="lg:col-span-5 lg:sticky lg:top-24">
  <div class="rounded-2xl bg-white border border-black/[0.06] shadow-[0_1px_12px_rgba(0,0,0,0.03)]">
    <div class="px-6 pt-5 pb-4 border-b border-black/[0.05]">
      <h2 class="text-[15px] font-bold tracking-tight">Formulir Inquiry</h2>
      <p class="text-[12px] text-ink-800/50 mt-0.5">Cek tagihan real-time sebelum membayar.</p>
    </div>

    <div class="p-6">
      <form id="form-inquiry" class="space-y-5">
        <div>
          <label for="product-select" class="block text-[12px] font-semibold text-ink-800 mb-1.5">Wilayah PDAM</label>
          <div class="relative">
            <select id="product-select" name="productCode" required class="w-full appearance-none rounded-xl bg-mist-50 border border-black/[0.07] px-4 py-2.5 text-[14px] font-medium text-ink-950 focus:bg-white focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all">
              <option value="WASDA">PDAM Sidoarjo (WASDA)</option>
              <option value="WABONDO">PDAM Bondowoso (WABONDO)</option>
            </select>
            <svg class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-ink-800/40" width="11" height="7" viewBox="0 0 11 7" fill="none"><path d="M1 1l4.5 4.5L10 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
        </div>

        <div>
          <label for="customer-id-input" class="block text-[12px] font-semibold text-ink-800 mb-1.5">Nomor ID Pelanggan</label>
          <input type="text" id="customer-id-input" name="customerId" required placeholder="Contoh: 01002676" class="w-full rounded-xl bg-mist-50 border border-black/[0.07] px-4 py-2.5 text-[14px] font-medium tracking-wide placeholder:text-ink-800/30 focus:bg-white focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all" />
          <p class="text-[11px] text-ink-800/45 mt-1.5">Atau klik IDPEL test di kartu bawah ini.</p>
        </div>

        <button type="submit" id="btn-submit-inquiry" class="w-full h-11 rounded-xl bg-accent-500 hover:bg-accent-600 active:bg-accent-700 text-white text-[14px] font-semibold transition-all flex items-center justify-center gap-2">
          <span>Cek Tagihan</span>
        </button>
      </form>

      <!-- Preset chips (click → isi form) -->
      <div class="pt-5 mt-5 border-t border-black/[0.05]">
        <div class="flex items-center justify-between mb-2.5">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-ink-800/40">List Produk Test (Hal 5)</span>
          <span class="text-[10px] text-ink-800/40">Klik untuk auto-fill</span>
        </div>
        <div id="preset-buttons" class="space-y-2"></div>
      </div>
    </div>
  </div>
</div>
