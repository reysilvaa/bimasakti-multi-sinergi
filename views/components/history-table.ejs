<!-- ============ HISTORY PAGE ============ -->
<section id="section-history" class="hidden">
  <!-- Stat cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl bg-white border border-black/[0.05] p-5">
      <p class="text-[11px] font-medium uppercase tracking-wider text-ink-800/40">Total Transaksi</p>
      <p id="stat-total-count" class="text-[22px] font-bold tabular-nums tracking-tight mt-1">0</p>
    </div>
    <div class="rounded-2xl bg-white border border-black/[0.05] p-5">
      <p class="text-[11px] font-medium uppercase tracking-wider text-ink-800/40">Status Sukses</p>
      <p id="stat-success-count" class="text-[22px] font-bold tabular-nums tracking-tight mt-1 text-emerald-600">0</p>
    </div>
    <div class="rounded-2xl bg-white border border-black/[0.05] p-5">
      <p class="text-[11px] font-medium uppercase tracking-wider text-ink-800/40">Total Nilai</p>
      <p id="stat-total-value" class="text-[22px] font-bold tabular-nums tracking-tight mt-1">Rp 0</p>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="flex items-center justify-between gap-3 mb-4">
    <div class="relative w-full max-w-xs">
      <input type="text" id="history-search-input" placeholder="Cari IDPEL, nama, atau no. resi…" class="w-full rounded-xl bg-white border border-black/[0.07] px-4 py-2.5 text-[13px] font-medium placeholder:text-ink-800/35 focus:border-accent-500 focus:ring-4 focus:ring-accent-500/10 outline-none transition-all" />
    </div>
    <button id="btn-refresh-history" class="h-10 px-4 rounded-xl bg-ink-950 hover:bg-ink-800 text-white text-[13px] font-semibold transition-colors shrink-0">Segarkan</button>
  </div>

  <!-- Table card -->
  <div class="rounded-2xl bg-white border border-black/[0.06] shadow-[0_1px_12px_rgba(0,0,0,0.03)] overflow-hidden">
    <div class="px-5 py-3.5 border-b border-black/[0.05] flex items-center justify-between">
      <h3 class="text-[13px] font-bold">Daftar Transaksi</h3>
      <span class="text-[11px] text-ink-800/45"><span id="history-count-badge" class="font-semibold text-ink-900">0</span> data</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-[13px]">
        <thead>
          <tr class="text-[10px] uppercase tracking-wider text-ink-800/40 border-b border-black/[0.06] bg-mist-50/60">
            <th class="py-3 px-5 font-medium">Waktu</th>
            <th class="py-3 px-4 font-medium">No. Resi</th>
            <th class="py-3 px-4 font-medium">PDAM</th>
            <th class="py-3 px-4 font-medium">IDPEL</th>
            <th class="py-3 px-4 font-medium">Nama</th>
            <th class="py-3 px-4 text-right font-medium">Total</th>
            <th class="py-3 px-4 text-center font-medium">Status</th>
            <th class="py-3 px-5 text-right font-medium">Aksi</th>
          </tr>
        </thead>
        <tbody id="history-tbody" class="divide-y divide-black/[0.04]"></tbody>
      </table>
    </div>
    <div id="history-empty-row" class="hidden p-14 text-center">
      <h5 class="text-[15px] font-semibold text-ink-900">Belum ada transaksi</h5>
      <p class="text-[13px] text-ink-800/50 mt-1">Riwayat pembayaran akan tampil di sini.</p>
    </div>
  </div>
</section>
