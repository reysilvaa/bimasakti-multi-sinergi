<!-- Floating Toast Notification -->
<div id="alert-banner" class="hidden animate-toast-in fixed top-5 right-6 z-50 max-w-md w-[calc(100%-3rem)] sm:w-auto min-w-[320px] rounded-2xl border p-4 shadow-2xl backdrop-blur-xl flex items-start gap-3 transition-all duration-300">
  <div id="alert-icon" class="shrink-0 mt-0.5"></div>
  <div class="flex-1 min-w-0">
    <h4 id="alert-title" class="text-[13px] font-bold tracking-tight"></h4>
    <p id="alert-desc" class="text-[12px] mt-0.5 opacity-90 leading-snug"></p>
  </div>
  <button id="alert-close-btn" class="shrink-0 text-current opacity-40 hover:opacity-100 transition-opacity p-0.5" title="Tutup pemberitahuan" aria-label="Tutup pemberitahuan">
    <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  </button>
</div>
