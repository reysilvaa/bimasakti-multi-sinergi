<!-- Result panel -->
<div class="lg:col-span-7 min-h-[420px]">
  <!-- Empty state -->
  <div id="inquiry-empty-state" class="rounded-2xl border border-dashed border-black/[0.1] bg-white/50 p-12 text-center flex flex-col items-center justify-center min-h-[420px]">
    <div class="w-14 h-14 rounded-2xl bg-white border border-black/[0.06] shadow-sm flex items-center justify-center mb-4 text-ink-800/30">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M7 3.5h10a1.5 1.5 0 0 1 1.5 1.5v15.5L12 17l-6.5 3.5V5A1.5 1.5 0 0 1 7 3.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
    </div>
    <h3 class="text-[15px] font-semibold text-ink-900">Belum ada tagihan diperiksa</h3>
    <p class="text-[13px] text-ink-800/50 max-w-xs mt-1.5 leading-relaxed">Pilih wilayah, masukkan ID Pelanggan, lalu klik Cek Tagihan.</p>
  </div>

  <!-- Loading state -->
  <div id="inquiry-loading-state" class="hidden animate-card-in rounded-2xl border border-black/[0.06] bg-white p-12 text-center flex flex-col items-center justify-center min-h-[420px]">
    <div class="w-10 h-10 rounded-full border-[3px] border-mist-200 border-t-accent-500 animate-spin mb-4"></div>
    <h3 class="text-[15px] font-semibold text-ink-900">Menghubungi server Rajabiller…</h3>
    <p class="text-[13px] text-ink-800/50 mt-1.5">Mengambil rincian tagihan real-time.</p>
  </div>

  <!-- Result card -->
  <div id="inquiry-result-card" class="hidden animate-card-in rounded-2xl bg-white border border-black/[0.06] shadow-[0_1px_12px_rgba(0,0,0,0.04)] overflow-hidden">
    <div class="px-6 pt-5 pb-5 border-b border-black/[0.05]">
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <span id="res-pdam-badge" class="text-[11px] font-semibold uppercase tracking-[0.08em] text-accent-500 block mb-1"></span>
          <h3 class="text-[17px] font-bold tracking-tight">Tagihan ditemukan</h3>
        </div>
      </div>
      <div class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-x-5 gap-y-3.5">
        <div>
          <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-800/40 block">ID Pelanggan</span>
          <p id="res-customer-id" class="text-[14px] font-semibold font-mono tracking-wide mt-0.5"></p>
        </div>
        <div>
          <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-800/40 block">No. Meter (nomet)</span>
          <p id="res-nomet" class="text-[14px] font-semibold font-mono tracking-wide mt-0.5 text-ink-800/75">-</p>
        </div>
        <div>
          <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-800/40 block">Nama</span>
          <p id="res-customer-name" class="text-[14px] font-semibold truncate mt-0.5"></p>
        </div>
        <div>
          <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-800/40 block">Jumlah Bulan</span>
          <p id="res-bill-count" class="text-[14px] font-semibold text-accent-500 mt-0.5"></p>
        </div>
        <div class="col-span-2 sm:col-span-4">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-800/40 block">Alamat</span>
          <p id="res-customer-address" class="text-[13px] text-ink-800/70 mt-0.5 leading-relaxed"></p>
        </div>
      </div>
    </div>

    <div class="px-6 py-5 space-y-5">
      <div>
        <div class="flex items-center justify-between mb-2.5">
          <h4 class="text-[13px] font-semibold text-ink-900">Rincian per periode</h4>
          <span class="text-[11px] text-ink-800/40">Rupiah (IDR)</span>
        </div>
        <table class="w-full text-[13px]">
          <thead>
            <tr class="text-left text-[10px] uppercase tracking-wider text-ink-800/40 border-b border-black/[0.06]">
              <th class="py-2 pr-4 font-medium">Periode</th>
              <th id="th-meter" class="py-2 pr-4 font-medium">Pemakaian</th>
              <th class="py-2 px-4 text-right font-medium">Air</th>
              <th class="py-2 px-4 text-right font-medium">Denda</th>
              <th id="th-misc" class="py-2 pl-4 text-right font-medium">Non-Air (Beban)</th>
            </tr>
          </thead>
          <tbody id="res-bills-tbody" class="divide-y divide-black/[0.04]"></tbody>
        </table>
      </div>

      <div class="rounded-xl bg-mist-50 border border-black/[0.04] p-4 space-y-2 text-[13px]">
        <div class="flex justify-between">
          <span class="text-ink-800/60">Tagihan pokok</span>
          <span id="res-nominal" class="font-semibold tabular-nums"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-ink-800/60">Total denda</span>
          <span id="res-penalty-total" class="font-semibold tabular-nums"></span>
        </div>
        <div id="row-misc-total" class="flex justify-between">
          <span class="text-ink-800/60">Total non-air</span>
          <span id="res-misc-total" class="font-semibold tabular-nums"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-ink-800/60">Biaya admin loket</span>
          <span id="res-admin-fee" class="font-semibold tabular-nums"></span>
        </div>
        <div class="pt-3 mt-3 border-t border-black/[0.06] flex items-end justify-between gap-4">
          <div class="min-w-0">
            <span class="text-[13px] font-semibold">Total pembayaran</span>
            <p id="res-terbilang" class="text-[11px] text-ink-800/50 italic mt-0.5 leading-snug"></p>
          </div>
          <span id="res-total-amount" class="text-[24px] leading-none font-bold text-accent-500 tabular-nums tracking-tight shrink-0"></span>
        </div>
      </div>

      <div class="flex flex-col-reverse sm:flex-row gap-3">
        <button type="button" id="btn-cancel-inquiry" class="sm:flex-1 h-11 rounded-xl border border-black/[0.1] hover:bg-mist-50 text-ink-900 font-semibold text-sm transition-colors">Batal</button>
        <button type="button" id="btn-proceed-payment" class="sm:flex-[2] h-11 rounded-xl bg-accent-500 hover:bg-accent-600 active:bg-accent-700 text-white font-semibold text-sm transition-all flex items-center justify-center gap-2">
          <span>Bayar Sekarang</span>
        </button>
      </div>
    </div>
  </div>
</div>
