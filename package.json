{
  "name": "bimasakti-multi-sinergi",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:client": "esbuild src/views/main.tsx --bundle --outfile=views/js/app.js --format=iife --target=es2020 --jsx=automatic --jsx-import-source=preact --loader:.md=text",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "decomment": "node scripts/strip-comments.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/scripts/migrate.js",
    "start": "node dist/server.js",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "test": "npm run build && node test_integration.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "marked": "^18.0.13",
    "mysql2": "^3.24.4",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "decomment": "^0.9.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
